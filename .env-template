VERSION=1.0
DATE=YYYY.MM.DD
#- URL_SRC : source for signed URL, can be one of INDEXD, CLOUD_FRONT, LOCAL, PUBLIC_S3 or DUMMY (default)
URL_SRC=DCF
# BACKEND_URL=http://127.0.0.1:4020/v1/graphql/
BACKEND_URL=https://your-backend.example/v1/graphql/
AUTH_ENABLED=false
# ACL File Authentication
# AUTHORIZATION_ENABLED=true
PROJECT=BENTO
# FAKE=true
# AUTH_URL=
 
# MySQL Session Storage
#MYSQL_SESSION_ENABLED=true
# If MYSQL_SESSION_ENABLED true, below env variables are required
MYSQL_HOST=<MYSQL_HOST>
MYSQL_PORT=3306
MYSQL_PASSWORD=<MYSQL_PASSWORD>
MYSQL_USER=<MYSQL_USER>
MYSQL_DATABASE=<MYSQL_DATABASE>
COOKIE_SECRET=<COOKIE_SECRET>
SESSION_TIMEOUT=1200
 
 
# DCF endpoints (example)
DCF_FILE_URL=https://nci-crdc-staging.datacommons.io/user/data/download/
DCF_FILE_URL_RAS=https://nci-crdc.datacommons.io/ga4gh/drs/v1/objects/
RAS_PASSPORT_VALIDATION_URL=https://stsstg.nih.gov/passport/validate
